{
  "name": "shelf-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "phone": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && tsc --noEmit -p api && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs}\"",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "sync-bots": "node scripts/sync-bots.mjs && node scripts/api-bots.mjs",
    "remove-name": "node scripts/remove-name.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@upstash/redis": "^1.41.0",
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=20"
  }
}
