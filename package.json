{
  "name": "grokbotshelf",
  "private": true,
  "description": "Grok Bot Shelf: a static directory of shared Grok Bot templates. The site itself has no runtime dependencies; these are for tests and one-off scripts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/validate.js && node test/run.js --fast",
    "validate": "node scripts/validate.js",
    "build": "node scripts/build.js",
    "add-bot": "node scripts/add-bot.js",
    "test": "node test/run.js",
    "test:fast": "node test/run.js --fast",
    "test:browser": "node test/run.js --browser",
    "test:list": "node test/run.js --list"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "puppeteer-core": "^23.11.1",
    "qrcode": "^1.5.4"
  }
}
